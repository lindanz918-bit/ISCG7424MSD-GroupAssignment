<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/tv_staff_table_number" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/just_eat_text_primary" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_staff_table_capacity" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/just_eat_text_secondary" />
        <TextView android:id="@+id/tv_staff_table_location" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/just_eat_text_secondary" />
        <TextView android:id="@+id/tv_staff_table_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/just_eat_primary" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_staff_table_toggle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textAllCaps="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
