<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/StaffBody" android:text="@string/staff_dashboard_title" android:textSize="14sp"/>
        <TextView style="@style/StaffTitle" android:text="@string/staff_workspace_title"/>
        <TextView style="@style/StaffBody" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:text="@string/staff_dashboard_subtitle"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/staffHomeOrders"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/staff_orders_action"
            app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/staff_primary">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_staff_orders" app:tint="@color/staff_surface" android:importantForAccessibility="no"/>
                <TextView style="@style/StaffCardTitle" android:text="@string/staff_ui_orders" android:textColor="@color/staff_surface" android:layout_marginTop="16dp" android:textSize="20sp"/>
                <TextView style="@style/StaffBody" android:text="@string/staff_ui_orders_hint" android:textColor="@color/staff_surface" android:layout_marginTop="8dp"/>
                <TextView style="@style/StaffBody" android:text="@string/staff_open_orders" android:textColor="@color/staff_surface" android:textStyle="bold" android:layout_marginTop="24dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/staffHomeTables" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/staff_ui_tables" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/staff_border" app:strokeWidth="1dp" app:cardBackgroundColor="@color/staff_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/staff_soft_panel" android:src="@drawable/ic_staff_tables" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView style="@style/StaffCardTitle" android:text="@string/staff_ui_tables"/>
                    <TextView style="@style/StaffBody" android:text="@string/staff_ui_tables_hint" android:layout_marginTop="4dp" android:textSize="14sp"/>
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_back" android:rotation="180" android:importantForAccessibility="no"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/staffHomeProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/staff_ui_profile" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/staff_border" app:strokeWidth="1dp" app:cardBackgroundColor="@color/staff_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/staff_soft_panel" android:src="@drawable/ic_staff_profile" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView style="@style/StaffCardTitle" android:text="@string/staff_ui_profile"/>
                    <TextView style="@style/StaffBody" android:text="@string/staff_ui_profile_hint" android:layout_marginTop="4dp" android:textSize="14sp"/>
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_back" android:rotation="180" android:importantForAccessibility="no"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/staff_border" android:layout_marginTop="24dp"/>
        <TextView style="@style/StaffBody" android:text="@string/staff_signed_in_as" android:textSize="14sp" android:layout_marginTop="20dp"/>
        <TextView android:id="@+id/staffAccountEmail" style="@style/StaffBody" android:textColor="@color/staff_text" android:layout_marginTop="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/staffSignOut" style="@style/StaffButton.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/staff_sign_out"/>
    </LinearLayout>
</ScrollView>
