<?xml version="1.0"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true" android:background="@color/staff_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btn_staff_profile_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back_action" android:src="@drawable/ic_back"/>
        <TextView style="@style/StaffBody" android:layout_width="0dp" android:layout_weight="1" android:text="@string/staff_dashboard_title" android:textSize="14sp"/>
      </LinearLayout>
      <TextView style="@style/StaffTitle" android:text="@string/staff_ui_profile"/>
      <TextView style="@style/StaffBody" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:text="@string/staff_ui_profile_hint"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/staff_soft_panel">
        <ImageView android:id="@+id/staff_avatar" android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="Profile avatar" android:src="@drawable/staff_avatar_placeholder"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
          <TextView style="@style/StaffCardTitle" android:text="Staff account"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/btn_staff_avatar" style="@style/StaffButton.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Change avatar"/>
        </LinearLayout>
      </LinearLayout>
      <TextView style="@style/StaffCardTitle" android:text="@string/staff_ui_personal" android:layout_marginTop="24dp"/>
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_staff_first_name" style="@style/StaffInput" android:hint="@string/staff_profile_first_name">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_staff_first_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:singleLine="true" android:textSize="16sp"/>
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_staff_last_name" style="@style/StaffInput" android:hint="@string/staff_profile_last_name">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_staff_last_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:singleLine="true" android:textSize="16sp"/>
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_staff_email" style="@style/StaffInput" android:hint="@string/staff_profile_email">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_staff_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:singleLine="true" android:textSize="16sp"/>
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_staff_phone" style="@style/StaffInput" android:hint="@string/staff_profile_phone">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_staff_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:singleLine="true" android:textSize="16sp"/>
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_staff_profile_save" style="@style/StaffButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/staff_ui_save"/>
      <TextView style="@style/StaffCardTitle" android:layout_marginTop="24dp" android:text="@string/staff_ui_security"/>
      <TextView style="@style/StaffBody" android:text="Email changes require verification. Use Change email below." android:textSize="14sp" android:layout_marginTop="8dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_staff_email" style="@style/StaffButton.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Change email"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_staff_password" style="@style/StaffButton.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Change password"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_staff_profile_cancel" style="@style/StaffButton.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Cancel"/>
    </LinearLayout>
  </LinearLayout>
</ScrollView>
