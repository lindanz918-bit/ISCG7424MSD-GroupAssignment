{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE'))",
        ".write": "auth != null && auth.uid === $uid && data.child('role').val() === 'STAFF' && data.child('status').val() === 'ACTIVE' && newData.child('role').val() === data.child('role').val() && newData.child('status').val() === data.child('status').val()"
      }
    },
    "Orders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE'",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE' && data.exists() && newData.exists() && newData.child('customerId').val() === data.child('customerId').val() && newData.child('tableId').val() === data.child('tableId').val() && newData.child('bookingDate').val() === data.child('bookingDate').val() && newData.child('guestCount').val() === data.child('guestCount').val()",
        "status": {
          ".validate": "newData.val() === data.val() || (data.val() === 'PENDING' && (newData.val() === 'ACCEPTED' || newData.val() === 'REJECTED')) || ((data.val() === 'ACCEPTED' || data.val() === 'PREPARING' || data.val() === 'READY') && (newData.val() === 'CANCELLED' || newData.val() === 'COMPLETED'))"
        },
        "servedItems": {
          "$item": {
            ".validate": "newData.val() === true && (data.val() === true || (root.child('OrderItems').child($id).child($item).exists() && (data.parent().parent().child('status').val() === 'ACCEPTED' || data.parent().parent().child('status').val() === 'PREPARING' || data.parent().parent().child('status').val() === 'READY')))"
          }
        },
        ".validate": "root.child('tableReservations').child(data.child('bookingDate').val()).child(data.child('tableId').val()).child('orderId').val() === $id && ((newData.child('status').val() === 'REJECTED' || newData.child('status').val() === 'CANCELLED') ? !newData.parent().parent().child('tableReservations').child(data.child('bookingDate').val()).child(data.child('tableId').val()).exists() : newData.parent().parent().child('tableReservations').child(data.child('bookingDate').val()).child(data.child('tableId').val()).child('orderId').val() === $id)"
      }
    },
    "OrderItems": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE'"
    },
    "tables": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE'",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE' && data.hasChildren(['isEnabled', 'occupancyStatus']) && newData.hasChildren(['tableNumber','capacity','isEnabled','occupancyStatus'])",
        "isEnabled": {
          ".validate": "newData.isBoolean()"
        },
        "occupancyStatus": {
          ".validate": "newData.val() === 'AVAILABLE' || newData.val() === 'OCCUPIED'"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": "newData.val() === data.val()"
        }
      }
    },
    "tableReservations": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE'",
      "$date": {
        "$table": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'STAFF' && root.child('users').child(auth.uid).child('status').val() === 'ACTIVE' && data.exists() && !newData.exists() && root.child('Orders').child(data.child('orderId').val()).child('bookingDate').val() === $date && root.child('Orders').child(data.child('orderId').val()).child('tableId').val() === $table && (root.child('Orders').child(data.child('orderId').val()).child('status').val() === 'PENDING' || root.child('Orders').child(data.child('orderId').val()).child('status').val() === 'ACCEPTED' || root.child('Orders').child(data.child('orderId').val()).child('status').val() === 'PREPARING' || root.child('Orders').child(data.child('orderId').val()).child('status').val() === 'READY') && (newData.parent().parent().parent().child('Orders').child(data.child('orderId').val()).child('status').val() === 'REJECTED' || newData.parent().parent().parent().child('Orders').child(data.child('orderId').val()).child('status').val() === 'CANCELLED')"
        }
      }
    }
  }
}
